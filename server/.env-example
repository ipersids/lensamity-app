# Goose supported environment variables (goose is a database migration tool)
# https://pressly.github.io/goose/documentation/environment-variables/
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:postgres@localhost:5432/test
GOOSE_MIGRATION_DIR=./migrations/sql
GOOSE_TABLE=public.goose_migrations

# PostgreSQL connection string://[user[:password]@][host][:port][/dbname]
DATABASE_URL=postgres://postgres:postgres@localhost:5432/test

# server
API_PORT=8080

# Session configuration
SESSION_SECRET=long_secret_string

# RustFS SDK (S3-compatible distributed object storage)
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_INTERNAL_ENDPOINT=http://rustfs:9000
S3_PUBLIC_ENDPOINT=http://s3.localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lensamity-dev
S3_FORCE_PATH_STYLE=true
