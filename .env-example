# app
VITE_BASE_API_URL=""
APP_PORT=5173

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_CONTAINER_NAME=db
POSTGRES_PORT=5432
POSTGRES_DB=lensamity
# PostgreSQL connection string://[user[:password]@][host][:port][/dbname]
DATABASE_URL=postgres://postgres:postgres@db:5432/test


# server
API_PORT=8080
SESSION_SECRET=long_secret_string

RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# RustFS SDK (S3-compatible distributed object storage)
# https://docs.rustfs.com/en/reference/environment-variables
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_REGION=us-east-1
RUSTFS_ENDPOINT_URL=http://localhost:9000
RUSTFS_VOLUMES=/data
RUSTFS_ADDRESS=0.0.0.0:9000
RUSTFS_CONSOLE_ADDRESS=0.0.0.0:9001
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_CORS_ALLOWED_ORIGINS=*
S3_INTERNAL_ENDPOINT=http://rustfs:9000
S3_PUBLIC_ENDPOINT=http://s3.localhost:9000
S3_BUCKET=lensamity-dev
S3_FORCE_PATH_STYLE=true
